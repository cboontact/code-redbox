{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redbox",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "redbox-db",
      "database_id": "c5fe7372-cbe5-4a8d-b246-fa87673d080d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "redbox-evidence"
    }
  ],
  "observability": {
    "enabled": true
  }
}
